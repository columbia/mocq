diff --git a/dataflowengineoss/src/main/scala/io/joern/dataflowengineoss/language/ExtendedCfgNode.scala b/dataflowengineoss/src/main/scala/io/joern/dataflowengineoss/language/ExtendedCfgNode.scala
index cd571cc2a..80d4a4624 100644
--- a/dataflowengineoss/src/main/scala/io/joern/dataflowengineoss/language/ExtendedCfgNode.scala
+++ b/dataflowengineoss/src/main/scala/io/joern/dataflowengineoss/language/ExtendedCfgNode.scala
@@ -69,6 +69,26 @@ class ExtendedCfgNode(val traversal: Iterator[CfgNode]) extends AnyVal {
     reachableByInternal(sources)
   }
 
+  /** MoCQ hook: the taint paths that *stalled* before reaching a source (reached a non-source
+    * parameter / unresolved call). Normally discarded by the query engine; exposed here so a
+    * failing `reachableByFlows` query can report how far propagation got and where it broke.
+    */
+  def reachableByPartialFlows[A](sourceTrav: IterableOnce[A], sourceTravs: IterableOnce[A]*)(implicit
+    context: EngineContext
+  ): Iterator[Path] = {
+    val startingPointsWithSources = sourceTravsToStartingPoints(sourceTrav +: sourceTravs*)
+    val sinks                     = traversal.dedup.toList.sortBy(_.id)
+    val engine                    = new Engine(context)
+    engine.backwards(sinks, startingPointsWithSources.map(_.startingPoint))
+    val partials = engine.lastPartialResults
+    engine.shutdown()
+    partials
+      .map(te => Path(removeConsecutiveDuplicates(te.path.filter(_.visible).map(_.node).toVector)))
+      .filter(_.elements.nonEmpty)
+      .distinctBy(_.elements.map(_.id))
+      .iterator
+  }
+
   private def removeConsecutiveDuplicates[T](l: Vector[T]): List[T] = {
     l.headOption.map(x => x :: l.sliding(2).collect { case Seq(a, b) if a != b => b }.toList).getOrElse(List())
   }
